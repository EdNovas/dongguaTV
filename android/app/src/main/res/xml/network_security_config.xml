<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- [adult] 隐私加固:
         ① 只允许 HTTPS(明文 HTTP 一律拒绝;服务器、图片、视频分片都要走 https)。
         ② 只信任系统证书:不信任用户自己装的 CA —— 否则装一个抓包证书就能看到全部请求(观看记录、令牌)。
         需要临时用 http 内网服务器调试时,另建 debug 构建自己改,别改这里。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
