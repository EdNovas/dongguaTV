    "muliSources": true,
    "useWebview": true,
    "useNativePlayer": true,
    "usePost": false,
    "useLegacyParser": false,
    "adBlocker": false,
    "userAgent": "",
    "baseURL": "https://www.moonci.com/",
    "searchURL": "https://www.moonci.com/search/-------------.html?wd=@keyword",
    "searchList": "//ul[contains(@class, 'hl-one-list')]/li[contains(@class, 'hl-list-item')]",
    "searchName": ".//div[contains(@class, 'hl-item-title')]/a",
    "searchResult": ".//div[contains(@class, 'hl-item-title')]/a",
    "chapterRoads": "//div[contains(@class, 'hl-play-source')]//ul[contains(@class, 'hl-plays-list')]",
    "chapterResult": ".//a[contains(@href, '/play/')]",
    "referer": "",
    "searchMode": "xpath",
    "chapterMode": "xpath",
    "antiCrawlerConfig": {
        "enabled": false,
        "captchaType": 1,
        "captchaImage": "",
        "captchaInput": "",
        "captchaButton": "",
        "captchaDetectType": 1,
        "captchaDetectValue": "",
        "captchaScript": ""
    },
    "dg": {
        "key": "kz_moonci",
        "name": "月之祠",
        "resolver": "maccms",
        "playPath": "/anime/{vid}/play/{sid}-{nid}.html",
        "detailPath": "/anime/{vid}.html",
        "vidFrom": "/anime/(\\d+)\\.html",
        "searchCover": ".//a[contains(@class,'hl-item-thumb')]",
        "searchRemarks": ".//span[contains(@class,'remarks')]",
        "roadNames": "//div[contains(@class,'hl-plays-from')]/a",
        "roadNameMap": { "X.1": "MP4线①", "X.2": "MP4线②", "X.3": "HLS线", "X.4": "MP4线③" },
        "detail": {
            "name": "//h2[contains(@class,'hl-dc-title')]",
            "cover": "re:<span class=\"hl-item-thumb hl-lazy\" title=\"[^\"]*\" data-original=\"([^\"]+)\"",
            "content": "re:<li class=\"hl-col-xs-12 blurb\"><em class=\"hl-text-muted\">简介：</em>([\\s\\S]*?)</li>",
            "remarks": "re:状态：</em><span class=\"hl-text-conch\">([^<]*)",
            "year": "re:年份：</em>((?:19|20)\\d{2})",
            "movie": "re:class=\"hl-crumb-item hl-text-muted\" href=\"/type/22\\.html\"",
            "movieType": "电影"
        }
    }
}
